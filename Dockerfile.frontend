# Dockerfile for Next.js Frontend
FROM node:20-slim

WORKDIR /code

# Install Node.js dependencies
COPY frontend/package*.json /code/frontend/
WORKDIR /code/frontend
RUN npm install

# Copy frontend code
COPY frontend /code/frontend

# Expose Next.js port
EXPOSE 3000

# Start Next.js dev server
CMD ["npm", "run", "dev"]
