# Copia este fichero como .env y rellena los valores marcados con <REEMPLAZAR>.

# --- LLM ---
LLM_PROVIDER=openai                 # openai | azure | gemini
OPENAI_API_KEY=<REEMPLAZAR>
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=<REEMPLAZAR_si_usas_gemini>
LLM_COST_INPUT_PER_1K=0.0005
LLM_COST_OUTPUT_PER_1K=0.0015

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                     # solo si usas Qdrant Cloud
QDRANT_EVIDENCE_COLLECTION=biomed_evidence_v1
QDRANT_CLAIMS_COLLECTION=biomed_claims_v1

# --- Embeddings y RAG ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384
RAG_TOPK=5
RAG_THR_GREEN=0.82
RAG_THR_YELLOW=0.70

# --- Fuentes de evidencia ---
EVIDENCE_SOURCES=epmc,pubmed,crossref
NCBI_EMAIL=<REEMPLAZAR_tu_email>    # lo piden las APIs de PubMed
CROSSREF_MAILTO=<REEMPLAZAR_tu_email>

# --- Rutas locales ---
WHOOSH_DIR=var/whoosh
LOGS_DIR=logs
AUDIT_LOG_PATH=logs/audit.log
